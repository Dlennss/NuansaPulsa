DATABASE_URL=postgres://user:password@127.0.0.1:5432/nuansapulsa?sslmode=disable
PORT=8080
JWT_SECRET=

# Rekening deposit khusus NuansaPulsa. Biarkan kosong sampai rekening resmi siap.
NUANSAPULSA_DEPOSIT_BANK_NAME=
NUANSAPULSA_DEPOSIT_ACCOUNT_NUMBER=
NUANSAPULSA_DEPOSIT_ACCOUNT_HOLDER=

# Primary upstream provider. Semua produk, cek saldo provider, dan transaksi
# H2H dikirim ke Pulsa24Jam. Provider lama seperti Yuscom/Javapay optional.
PULSA24JAM_BASE_URL=https://api.pulsa24jam.net
PULSA24JAM_API_KEY=
PULSA24JAM_PIN=
PULSA24JAM_PASSWORD=
PULSA24JAM_SECRET=
PULSA24JAM_CALLBACK_TOKEN=
PULSA24JAM_CALLBACK_IP=
PULSA24JAM_TIMEOUT=30s
PULSA24JAM_PRODUCT_SYNC_INTERVAL=15m

# Optional legacy providers. Biarkan kosong jika semua transaksi sudah lewat Pulsa24Jam.
YUSCOM_BASE_URL=
YUSCOM_MEMBERID=
YUSCOM_PIN=
YUSCOM_PASSWORD=
YUSCOM_TIMEOUT=20s

JAVAPAY_BASE_URL=
JAVAPAY_MEMBERID=
JAVAPAY_APIKEY=
JAVAPAY_PIN=
JAVAPAY_TIMEOUT=15s
